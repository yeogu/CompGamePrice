# Docker Compose/NAS 공개 주소. 운영에서는 반드시 실제 HTTPS 주소로 변경합니다.
APP_ENV=production
WEB_APP_URL=https://games.example.com
OAUTH_CALLBACK_BASE=https://games.example.com
COOKIE_SECURE=true
CATALOG_ADMIN_ENABLED=true
WEB_PORT=8088

# OAuth를 사용할 때 client ID와 secret을 한 쌍으로 설정합니다.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=
NAVER_OAUTH_CLIENT_ID=
NAVER_OAUTH_CLIENT_SECRET=

# 실제 이메일 알림 worker에서 사용합니다.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
