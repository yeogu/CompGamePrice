# Docker Compose/NAS 공개 주소. 운영에서는 반드시 실제 HTTPS 주소로 변경합니다.
APP_ENV=production
WEB_APP_URL=https://games.example.com
OAUTH_CALLBACK_BASE=https://games.example.com
COOKIE_SECURE=true
CATALOG_ADMIN_ENABLED=true
WEB_PORT=8088

# OAuth를 사용할 때 client ID와 secret을 한 쌍으로 설정합니다.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=
NAVER_OAUTH_CLIENT_ID=
NAVER_OAUTH_CLIENT_SECRET=

# 실제 이메일 알림 worker에서 사용합니다.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
EMAIL_DISPATCH_INTERVAL_SECONDS=30

# 가격과 카탈로그를 6시간마다 자동 갱신합니다. Store 과부하를 막기 위해 최소 300초입니다.
COLLECTION_INTERVAL_SECONDS=21600
COLLECTION_INITIAL_DELAY_SECONDS=120
COLLECTION_CATALOG_BATCH_SIZE=30
COLLECTION_STEAM_DISCOVERY_LIMIT=75
COLLECTION_STEAM_DISCOVERY_PAGES=4
COLLECTION_ENABLED=true

# 검증된 DB·카탈로그 백업을 하루마다 만들고 최근 14일만 보관합니다.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_INITIAL_DELAY_SECONDS=300
BACKUP_RETENTION_DAYS=14
