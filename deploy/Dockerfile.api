FROM ubuntu:24.04 AS build
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake libbrotli-dev libdrogon-dev libhiredis-dev libjsoncpp-dev \
    libmariadb-dev libpq-dev libsqlite3-dev libssl-dev libtrantor-dev \
    libyaml-cpp-dev uuid-dev zlib1g-dev && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY . .
RUN cmake -S . -B /tmp/build -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_POLICY_DEFAULT_CMP0153=OLD \
    -DBUILD_TESTING=OFF -DBUILD_GAME_PRICE_API=ON && \
    cmake --build /tmp/build --parallel --target game_price_api game_price_tracker

FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libdrogon1 libsqlite3-0 libssl3 python3 && \
    rm -rf /var/lib/apt/lists/*
COPY --from=build /tmp/build/game_price_api /app/game_price_api
COPY --from=build /tmp/build/game_price_tracker /app/game_price_tracker
COPY --from=build /src/data /app/seed-data
COPY --from=build /src/tools /app/tools
COPY --from=build /src/deploy/start-api.sh /app/start-api.sh
WORKDIR /app
ENV GAME_PRICE_API_PORT=8080
ENV GAME_PRICE_API_HOST=0.0.0.0
ENV GAME_PRICE_DATABASE_PATH=/data/game_prices.db
ENV GAME_PRICE_CATALOG_PATH=/data/game_catalog.json
ENV GAME_PRICE_PROJECT_PATH=/app
ENV GAME_PRICE_TRACKER_PATH=/app/game_price_tracker
EXPOSE 8080
CMD ["/app/start-api.sh"]
